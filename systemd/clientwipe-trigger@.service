[Unit]
Description=ClientWipe - sanitisation declenchee par cle USB (serial=%i)
After=local-fs.target

[Service]
Type=oneshot
# %i = numero de serie de la cle USB (ID_SERIAL_SHORT), fourni par la regle udev.
# Adaptez --root a l'emplacement reel du poste/profil de travail pentest.
# --yes : ce service n'a pas de terminal interactif pour confirmer. C'est
# l'allow-list de numeros de serie (verifiee par clientwipe lui-meme avant
# d'arriver ici) qui constitue l'autorisation reelle du declenchement USB.
ExecStart=/usr/local/bin/clientwipe trigger \
    --serial %i \
    --allowlist /etc/clientwipe/allowed_usb_serials.txt \
    --config /etc/clientwipe/sanitize_targets.yaml \
    --root /home/pentest \
    --yes
StandardOutput=journal
StandardError=journal
